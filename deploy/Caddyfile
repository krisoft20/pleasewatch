{$PW_HOSTNAME} {
	encode zstd gzip
	request_body {
		max_size 50GB
	}

	@html {
		path /
		path *.html
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"
	header @html Pragma "no-cache"

	@immutable {
		path /_app/immutable/*
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy pleasewatch:3000 {
		flush_interval -1
		transport http {
			read_timeout 6h
			write_timeout 6h
		}
	}
}
