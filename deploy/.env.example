PW_HOSTNAME=:80
PUBLIC_BASE_URL=
TZ=UTC
PUID=1000
PGID=1000

# leave blank and add it in /onboarding, or paste it here before setup.
# get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# optional subtitle search key. can be added later in admin settings.
WYZIE_API_KEY=

# generated on first run of setup.sh; leave blank for a fresh install.
JWT_SECRET=
QBIT_USER=admin
QBIT_PASS=

# download services can be configured through admin settings after first boot.
# optional comma-separated Jackett indexer ids can be set here after configuring Jackett.
JACKETT_API_KEY=
JACKETT_INDEXERS_MOVIE=
JACKETT_INDEXERS_TV=
JACKETT_INDEXERS_ANIME=
JACKETT_INDEXERS_BOOK=

# prowlarr is optional. expose its ui temporarily with deploy/prowlarr-expose.sh.
PROWLARR_API_KEY=

QBIT_BIND=127.0.0.1:8080
QBIT_P2P_PORT=6881

# default stores media next to deploy/. point this at a mounted disk for bigger libraries.
PW_MEDIA_DIR=../media

VPN_PROVIDER=
VPN_TYPE=wireguard
VPN_COUNTRIES=
SERVER_CITIES=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_MTU=1320
OPENVPN_USER=
OPENVPN_PASSWORD=

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
