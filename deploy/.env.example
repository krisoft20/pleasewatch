PW_HOSTNAME=:80
PUBLIC_BASE_URL=
TZ=UTC
PUID=1000
PGID=1000

# leave blank and add it in /onboarding, or paste it here before setup.
# get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# optional subtitle search key. can be added later in admin settings.
WYZIE_API_KEY=

QBIT_USER=admin
QBIT_PASS=

# download services can be configured through admin settings after first boot.
# optional comma-separated Jackett indexer ids can be set here after configuring Jackett.
JACKETT_API_KEY=
JACKETT_INDEXERS_MOVIE=
JACKETT_INDEXERS_TV=
JACKETT_INDEXERS_ANIME=
JACKETT_INDEXERS_BOOK=

# prowlarr is optional. expose its ui temporarily with deploy/prowlarr-expose.sh.
PROWLARR_API_KEY=

QBIT_BIND=127.0.0.1:8080
QBIT_P2P_PORT=6881

# default stores media next to deploy/. point this at a mounted disk for bigger libraries.
PW_MEDIA_DIR=../media

VPN_PROVIDER=
VPN_TYPE=wireguard
VPN_COUNTRIES=
SERVER_CITIES=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_MTU=1320
OPENVPN_USER=
OPENVPN_PASSWORD=

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# live sports (optional). leave blank to disable the Live tab. LIVE_INDEX_URLS
# is a comma-separated list of key=url pairs, one per sport index page - the key
# becomes the tab in the Live hub. LIVE_ALLOWED_ORIGINS is the comma-separated
# https:// prefixes the resolver may walk into. keep values here (in .env,
# gitignored) instead of the source tree.
# the sport of each game is read from its own link, so a mixed page like the
# site root can be one of the entries - that is where the soccer leagues live.
# duplicates across sources collapse to one row.
# LIVE_INDEX_URLS=top=https://host/,cfb=https://host/cfbstreams3,nfl=https://host/nflstreams3
LIVE_INDEX_URLS=
LIVE_ALLOWED_ORIGINS=

# livetv.sx as a second live source. it lists Ekstraklasa and other leagues
# streameast does not carry, but every one of its mirrors frames a third-party
# player - a sample of 24 events turned up 11 distinct provider hosts and none
# of them could be cracked by parsing. so we run the mirror in a headless
# chromium (the "sniffer" service) and take whichever playlist it plays.
# the playlists come back bound to the requesting IP, so the sniffer must run
# on the same host as this backend.
# set a token to switch it on; empty disables livetv entirely.
SNIFFER_TOKEN=
SNIFFER_CONCURRENT=3
SNIFFER_TIMEOUT=60000
LIVETV_INDEX_URL=https://livetv.sx/enx/
# comma-separated substrings matched against "Country. League" and sport.
# empty keeps every event livetv lists (~100), which will swamp the board.
# LIVETV_FILTER=poland
LIVETV_FILTER=
LIVETV_ENABLED=1

# the live board is kept warm in the background so nobody waits on a scrape.
# a full refresh costs ~5s (eleven index pages, the espn join, and a headless
# page load for livetv). polling pauses after 15 minutes with nobody asking.
LIVE_REFRESH_SECS=60
